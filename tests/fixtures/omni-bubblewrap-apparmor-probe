#include <tunables/global>

profile omni-bubblewrap-probe flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network,
  capability,
  file,
  umount,
  signal (receive) peer=unconfined,
  signal (receive) peer=runc,
  signal (receive) peer=crun,
  signal (receive) peer=docker-default,
  signal (send,receive) peer=omni-bubblewrap-probe,
  ptrace (trace,read,tracedby,readby) peer=omni-bubblewrap-probe,

  deny @{PROC}/* w,
  deny @{PROC}/{[^1-9],[^1-9][^0-9],[^1-9s][^0-9y][^0-9s],[^1-9][^0-9][^0-9][^0-9/]*}/** w,
  deny @{PROC}/sys/[^k]** w,
  deny @{PROC}/sys/kernel/{?,??,[^s][^h][^m]**} w,
  deny @{PROC}/sysrq-trigger rwklx,
  deny @{PROC}/kcore rwklx,
  deny /sys/[^f]*/** wklx,
  deny /sys/f[^s]*/** wklx,
  deny /sys/fs/[^c]*/** wklx,
  deny /sys/fs/c[^g]*/** wklx,
  deny /sys/fs/cg[^r]*/** wklx,
  deny /sys/firmware/** rwklx,
  deny /sys/devices/virtual/powercap/** rwklx,
  deny /sys/kernel/security/** rwklx,

  audit mount options=(rw,silent,rslave) -> /,
  audit mount fstype=tmpfs options=(rw,nosuid,nodev) tmpfs -> /tmp/,
  audit mount options=(rw,rbind) /tmp/newroot/ -> /tmp/newroot/,
  audit pivot_root oldroot=/tmp/oldroot/ /tmp/,
  audit mount options=(rw,rbind) /oldroot/usr/ -> /newroot/usr/,
  audit mount options=(ro,nosuid,nodev,remount,bind,relatime) -> /newroot/usr/,
  audit mount fstype=proc options=(rw,nosuid,nodev,noexec) proc -> /newroot/proc/,
  audit mount fstype=tmpfs options=(rw,nosuid,nodev) tmpfs -> /newroot/{dev,tmp}/,
  audit mount options=(rw,rbind) /oldroot/dev/null -> /newroot/dev/null,
  audit mount options=(rw,rbind) /oldroot/dev/zero -> /newroot/dev/zero,
  audit mount options=(rw,rbind) /oldroot/dev/full -> /newroot/dev/full,
  audit mount options=(rw,rbind) /oldroot/dev/random -> /newroot/dev/random,
  audit mount options=(rw,rbind) /oldroot/dev/urandom -> /newroot/dev/urandom,
  audit mount options=(rw,rbind) /oldroot/dev/tty -> /newroot/dev/tty,
  audit mount fstype=devpts options=(rw,nosuid,noexec) devpts -> /newroot/dev/pts/,
  audit mount options=(rw,silent,rprivate) -> /oldroot/,
  audit pivot_root oldroot=/newroot/ /newroot/,
}
